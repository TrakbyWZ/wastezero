table 'public log_entries'
	lineageTag: 30297e47-6c77-48c8-aa2b-f1ef8068844e

	measure cnt_of_reads = CALCULATE(COUNTROWS('public log_entries'))
		formatString: #,0
		lineageTag: debf8aa5-ca09-47a8-b7a5-cffc380e9061

	measure cnt_of_bad_reads = ```
			CALCULATE(
			    COUNTROWS('public log_entries'), 
			    CONTAINSSTRING('public log_entries'[data_value], "bad")
			)
			```
		formatString: #,0
		lineageTag: 9d5eea68-02c5-4f66-ae6f-15d859191d7e

	measure pct_good_reads = ([cnt_of_reads] - [cnt_of_bad_reads])/[cnt_of_reads]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 44018589-e584-46e2-9136-0ec44d5a1e60

	measure cnt_of_good_reads = [cnt_of_reads] - [cnt_of_bad_reads]
		formatString: #,0
		lineageTag: ec167129-6e1a-47a0-a636-8575a94072a5

	measure job_duration_in_hrs = ```
			DATEDIFF(
			    SELECTEDVALUE('public log_entries'[job_start_timestamp]), 
			    SELECTEDVALUE('public log_entries'[job_end_timestamp]), 
			    HOUR
			)
			```
		formatString: #,0.00
		lineageTag: b76e4f74-5129-43fb-809c-32a8b2bf8909

