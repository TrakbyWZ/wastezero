	partition 'public log_entries' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("127.0.0.1:54322", "postgres"),
				    public_log_entries = Source{[Schema="public",Item="log_entries"]}[Data],
				    #"Added Custom" = Table.AddColumn(public_log_entries, "data_type", each if Text.Contains([data_value], "Bad") then "Bad Read" else "Good Read"),
				    #"Duplicated Column" = Table.AddColumn(#"Added Custom", "Customer Code", each [data_value], type text),
				    #"Trimmed Text" = Table.TransformColumns(#"Duplicated Column", {{"Customer Code", each Text.Start(_, 5), type text}})
				in
				    #"Trimmed Text"

